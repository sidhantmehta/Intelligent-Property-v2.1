# Copy to .env and fill in. Never commit the real .env file.

# HERE platform API key (https://platform.here.com/) used for Geocoding & Search
# (Discover) and Routing/Matrix Routing APIs. Current HERE auth is a plain
# apiKey query parameter -- NOT the legacy app_id/app_code pair v2 used.
HERE_API_KEY=

# Path to the SQLite database file, relative to the repo root.
GEO_MODEL_DB_PATH=geo_model.db

# Path to config.yaml, relative to the repo root.
GEO_MODEL_CONFIG_PATH=config.yaml

# Console + file log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Directory rotating log files are written to.
GEO_MODEL_LOG_DIR=logs
